
# Supabase — required for persistent storage and file uploads
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Admin login — required
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Login rate limiting — required
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-token

# Application URL — used in generated embed snippets
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email notifications — optional; configure all three to enable
FORM_NOTIFICATION_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Outgoing webhook — optional
FORM_WEBHOOK_URL=
